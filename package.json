{
  "name": "tessera-qr",
  "private": true,
  "version": "0.1.0",
  "description": "Craft QR codes worth scanning.",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Gaurav Jadhav",
    "email": "ggauravj5@gmail.com",
    "url": "https://gauravjadhav.vercel.app/"
  },
  "homepage": "https://github.com/GgauravJ05/tessera-qr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GgauravJ05/tessera-qr.git"
  },
  "bugs": {
    "url": "https://github.com/GgauravJ05/tessera-qr/issues"
  },
  "keywords": [
    "qr",
    "qr-code",
    "qr-generator",
    "wifi-qr",
    "vcard",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "client-side",
    "privacy"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "lint:fix": "oxlint --fix",
    "format:check": "prettier --check .",
    "lab:build": "rolldown -c tools/scanlab/rolldown.config.mjs",
    "lab:smoke": "npm run lab:build && node tools/scanlab/cli.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "oxlint": "^1.82.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
